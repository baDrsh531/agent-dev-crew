# Copy to .env and fill in.

# anthropic | openai_compatible | fake
#   anthropic         Claude API. Needs ANTHROPIC_API_KEY.
#   openai_compatible Any /v1/chat/completions server: llama.cpp, vLLM, SGLang,
#                     LM Studio, Ollama. Needs OPENAI_BASE_URL + OPENAI_MODEL.
#   fake              Scripted/synthesised responses — no key, no cost,
#                     deterministic. Used by the test suite.
# A provider whose settings are incomplete falls back to "fake" at startup
# rather than failing halfway through a run.
LLM_PROVIDER=openai_compatible

# --- anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- openai_compatible -----------------------------------------------------
# One URL, or several separated by commas. With several, each run is pinned to
# one server for its whole life — a local server caches the prompt prefix, and
# every turn of a run shares all but its tail with the previous one, so moving
# a conversation between servers throws that away. Runs then overlap: three
# servers means three runs, or a benchmark suite in a third of the time.
# They must all serve the SAME model; GET /api/health/endpoints reports it if
# they do not.
#   OPENAI_BASE_URL=http://10.0.0.10:8080/v1,http://10.0.0.11:8080/v1
OPENAI_BASE_URL=http://127.0.0.1:8080/v1

# The opposite case: a second server running a DIFFERENT model, given to named
# roles. Syntax `role=url|model`, comma-separated; the model name is required
# because a server usually only answers to the exact name it reports, and
# finding that out mid-run is worse than refusing at startup. Whether a small
# model is good enough for a role is a benchmark question — measure it.
#   OPENAI_ROLE_ENDPOINTS=documenter=http://10.0.0.11:8080/v1|/models/small.gguf
OPENAI_ROLE_ENDPOINTS=

# Usually blank for a local server.
OPENAI_API_KEY=
# Exactly as reported by GET /v1/models.
OPENAI_MODEL=E:\vllm_models\gguf\Qwen_Qwen3.6-35B-A3B-Q4_K_M.gguf
# Qwen3-family reasoning toggle. Off makes runs much faster and cheaper in
# tokens; on gives better plans and reviews.
OPENAI_ENABLE_THINKING=true
# The server's context window (llama.cpp reports it as n_ctx in /v1/models).
# Per-request output budgets are capped at a quarter of this.
OPENAI_MAX_CONTEXT_TOKENS=65536

# Decoding. Leave these empty to use the server's own defaults — but note that
# "no temperature" means "the server samples", not "deterministic": three
# identical requests returned three different plans. Qwen3 recommends ~0.7 for
# reasoning. Benchmarks pin temperature to 0 regardless, so a comparison
# measures the change and not the dice.
OPENAI_TEMPERATURE=
OPENAI_TOP_P=
OPENAI_TOP_K=
OPENAI_SEED=

# Per-role model routing. Deep reasoning gets Opus, mechanical work gets cheaper tiers.
MODEL_ORCHESTRATOR=claude-opus-5
MODEL_ANALYST=claude-sonnet-5
MODEL_ARCHITECT=claude-opus-5
MODEL_DEVELOPER=claude-sonnet-5
MODEL_QA=claude-sonnet-5
MODEL_DOCUMENTER=claude-haiku-4-5

# Intake: an agent restates a non-developer's request in plain language and gets
# it confirmed before any work starts. Turn off when requests already arrive as
# precise engineering statements (another program, a benchmark).
INTAKE_ENABLED=true
MAX_INTAKE_ROUNDS=3

# Inject a static map of the repository (routes, classes, functions) into every
# system prompt. ON by default: measured over three repetitions per task it
# saves 10% of tokens and 11% of tool calls overall, and takes tag_validation
# from failing every repetition to passing every one.
# The exception matters — jwt_auth, the longest conversation of the four, goes
# from 290-337k tokens to 406-427k and straight through the 400k ceiling. On a
# task with that much back-and-forth, raise the budget or turn this off.
# See benchmarks/README.md.
REPO_MAP_ENABLED=true

# Hard ceilings. A run that hits any of these stops and escalates to the human.
MAX_QA_ITERATIONS=3
MAX_TOKENS_PER_RUN=400000
MAX_WALL_CLOCK_SECONDS=900
MAX_TOOL_CALLS_PER_AGENT=40

# Where the crew actually works. This directory is disposable: it is created by
# copying WORKSPACE_TEMPLATE, so the committed demo repo is never mutated and
# every run starts from an identical state.
WORKSPACE_ROOT=./data/workspace

# Pristine template copied into WORKSPACE_ROOT when it is empty.
# Leave EMPTY to work directly in WORKSPACE_ROOT — that is what you want when
# pointing the crew at a real project of your own.
WORKSPACE_TEMPLATE=./demo-repo

# Required to work on a project that is not the disposable demo workspace.
# The crew branches and commits in that repository, so it must never happen by
# leaving a path misconfigured. Preflight also demands a git repo, a clean
# working tree and an attached HEAD before any run starts.
ALLOW_EXTERNAL_WORKSPACE=false

# ask | risky | auto — how much a run asks before acting. Overridable per run.
#   ask    every write, command and commit
#   risky  only what a `git reset` cannot undo (commands, installs) — a run
#          works on its own branch, so file edits are reversible and pass
#   auto   nothing; the run still escalates when it hits a limit
APPROVAL_MODE=ask

DATABASE_PATH=./data/runs.db
